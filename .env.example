# Prasanth Jewellers AI Headquarters ONLY. This is not the SPLCART store.
# Database must be a dedicated, empty Headquarters PostgreSQL database.
DATABASE_URL="postgresql://hq:REPLACE_WITH_DB_SECRET@127.0.0.1:5432/hq?schema=public"

# Independent owner credentials (never reuse SPLCART admin passwords).
OWNER_USERNAME="hq-owner"
OWNER_PASSWORD="REPLACE_WITH_LONG_RANDOM_SECRET"
HQ_SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# For a real production deployment, specify its actual HTTPS origin.
HQ_PUBLIC_ORIGIN="https://hq.your-domain.example"
# Never configure HQ_TEST_MODE on a real deployment. Reserved for ephemeral local CI.
# HQ_TEST_MODE="1"

# Browser inspector: no Google/social scraping. Production must use an isolated worker
# with audited outbound egress before enabling owner-submitted research.
# Comma separated approved independent business hostnames:
HQ_ALLOWED_RESEARCH_HOSTS=""
# Set only once infrastructure enforces container network isolation:
# Set to 1 ONLY after actual external host network-level egress testing.
HQ_BROWSER_EGRESS_VERIFIED="0"
HQ_BROWSER_WORKER_URL="http://hq-browser:3900"
HQ_BROWSER_WORKER_TOKEN="REPLACE_WITH_SEPARATE_LONG_RANDOM_WORKER_SECRET"
# Dedicated Docker Compose database secret, not a store database password.
HQ_DB_PASSWORD="REPLACE_WITH_HQ_ONLY_POSTGRES_PASSWORD"

# No SPLCART integration tokens, shop database credentials or shared deployment settings.
